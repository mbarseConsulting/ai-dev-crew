# Ignore contenu de local/ mais garde la structure
local/*
!local/.gitkeep
!local/*/
!local/**/.gitkeep

# Configuration locale Claude Code
.claude/settings.local.json

# Vestiges de l'ère plugin — à supprimer une fois la migration validée
.attic/

# Rien de projet ni d'employeur dans la bibliotheque : elle voyage a vie, un projet est jetable.
# Garde-fou contre une reintroduction ; le profil projet vit hors de ce depot.
.claude/skills/**/references/house-rules.md
# crew-project : le routeur et le template suivent leur porteur, les projets sont jetables
.claude/skills/crew-project/*
!.claude/skills/crew-project/SKILL.md
!.claude/skills/crew-project/templates/
!.claude/skills/crew-project/templates/*

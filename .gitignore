# Fichiers temporaires
*.tmp
*.temp
temp/
tmp/

# Logs
*.log
logs/

# Notes personnelles (optionnel - décommenter si souhaité)
# notes/personal/

# Ignore contenu de local/ mais garde la structure
local/*
!local/.gitkeep
!local/*/
!local/**/.gitkeep

# Configuration locale Claude Code
.claude/settings.local.json

# Vestiges de l'ère plugin — à supprimer une fois la migration validée
.attic/

# Nothing project- or employer-specific in the library: it travels for life, a project is disposable.
# Guard against reintroduction; the project profile lives outside this repository.
.claude/skills/**/references/house-rules.md
# crew-project: the router and the template follow their owner, projects are disposable
.claude/skills/crew-project/*
!.claude/skills/crew-project/SKILL.md
!.claude/skills/crew-project/references/
!.claude/skills/crew-project/references/*
